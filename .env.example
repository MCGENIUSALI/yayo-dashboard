# YA YO! dashboard — server configuration. Copy to .env.local for local development.
# None of these variables is NEXT_PUBLIC_: they never reach the browser bundle.
# Values below are placeholders, not working credentials.

# Public base URL of the app (links in e-mails, Google redirect URI, Secure cookies when https://).
# On Vercel it defaults to the production / deployment URL when unset.
APP_URL=http://localhost:3000

# Postgres connection string (Neon: use the pooled URL, with ?sslmode=require).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yayo_dev

# 32+ random characters, signs the OAuth state and keys the hashed log / rate-limit identifiers.
# Generate: openssl rand -base64 48
AUTH_SECRET=replace-with-output-of-openssl-rand-base64-48

# Google OAuth 2.0 web client (Google Cloud Console > APIs & Services > Credentials).
# Authorised redirect URI: <APP_URL>/auth/google/callback. Leave empty to disable the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail delivery: "resend" (production) or "file" (local development / tests, refused in production).
EMAIL_TRANSPORT=file
EMAIL_FILE_DIR=.mail
# Required with EMAIL_TRANSPORT=resend. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="YA YO! <no-reply@example.com>"

# Breached-password check against Have I Been Pwned (k-anonymity). on | off
AUTH_PASSWORD_BREACH_CHECK=on

# Trust x-forwarded-for / x-real-ip for per-IP rate limits. Automatic on Vercel (VERCEL=1);
# set to 1 only behind a proxy that overwrites these headers.
AUTH_TRUST_PROXY=0
